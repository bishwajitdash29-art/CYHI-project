generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int         @id @default(autoincrement())
  username           String      @unique // Email (e.g. 25bcs002@iiitdmj.ac.in) or generic username
  password           String
  role               String      // "STUDENT", "PROFESSOR", "COMMITTEE"
  name               String
  complaintsReceived Complaint[] @relation("ReceivedComplaints")
  complaintsFiled    Complaint[] @relation("FiledComplaints")
  replies            Reply[]
  reposts            Repost[]
  proposals          Proposal[]
  upvotes            Upvote[]
  createdAt          DateTime    @default(now())
}

model Complaint {
  id            Int      @id @default(autoincrement())
  trackingToken String   @unique // used by student to track
  title         String
  description   String
  status        String   @default("PENDING") // "PENDING", "IN_PROGRESS", "RESOLVED"
  
  targetId      Int?
  target        User?    @relation("ReceivedComplaints", fields: [targetId], references: [id])
  
  authorId      Int?
  author        User?    @relation("FiledComplaints", fields: [authorId], references: [id])
  
  replies       Reply[]
  reposts       Repost[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Reply {
  id          Int       @id @default(autoincrement())
  message     String
  complaintId Int
  complaint   Complaint @relation(fields: [complaintId], references: [id])
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  createdAt   DateTime  @default(now())
}

model Repost {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  complaintId Int
  complaint   Complaint @relation(fields: [complaintId], references: [id])
  createdAt   DateTime  @default(now())

  @@unique([userId, complaintId])
}

model AnonymityLog {
  id        Int      @id @default(autoincrement())
  userHash  String   @unique // Hash of (userId + date + secret) to strictly decouple identity from complaints
  createdAt DateTime @default(now())
}

model Proposal {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  department  String   @default("General")
  status      String   @default("OPEN") // "OPEN", "IN_REVIEW", "APPROVED", "DENIED"
  
  authorId    Int?
  author      User?    @relation(fields: [authorId], references: [id])
  
  upvotes     Upvote[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Upvote {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  proposalId Int
  proposal   Proposal @relation(fields: [proposalId], references: [id])
  createdAt  DateTime @default(now())
  
  @@unique([userId, proposalId])
}

model Election {
  id          Int      @id @default(autoincrement())
  title       String
  status      String   @default("UPCOMING")
  startTime   DateTime?
  endTime     DateTime?
  candidates  Candidate[]
  voters      EligibleVoter[]
  createdAt   DateTime @default(now())
}

model Candidate {
  id          Int      @id @default(autoincrement())
  name        String
  manifesto   String
  electionId  Int
  election    Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  votesCount  Int      @default(0)
}

model EligibleVoter {
  id          Int      @id @default(autoincrement())
  studentId   String
  electionId  Int
  election    Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  hasVoted    Boolean  @default(false)
  
  @@unique([studentId, electionId])
}
